# --- App ---
APP_NAME=concord
APP_ENV=dev
SECRET_KEY=change-me-in-prod-32-bytes-minimum
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Postgres ---
POSTGRES_USER=concord
POSTGRES_PASSWORD=concord-dev-password
POSTGRES_DB=concord
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://concord:concord-dev-password@postgres:5432/concord

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Sandbox ---
SANDBOX_IMAGE=concord-sandbox:latest
SANDBOX_MEM_LIMIT=128m
SANDBOX_CPU_QUOTA=50000   # 0.5 CPU in microseconds per 100ms
SANDBOX_PIDS_LIMIT=64
SANDBOX_TIMEOUT_SECONDS=10
# Collaborative debugger (Python): on by default; a session ends after the timeout,
# or after the idle time paused with nobody stepping.
ENABLE_DEBUGGER=true
SANDBOX_DEBUG_TIMEOUT_SECONDS=600
SANDBOX_DEBUG_IDLE_SECONDS=180
SANDBOX_NETWORK=none

# --- Worker ---
WORKER_CONCURRENCY=2

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# --- AI assistant (Mistral) ---
# Free key from https://console.mistral.ai . Leave empty to require a
# per-project key (set by the project owner in the AI panel).
MISTRAL_API_KEY=
# codestral-latest: code-tuned, supports function calling, and has quota on
# free trial keys (mistral-small-latest can have a 0 req/min quota there).
MISTRAL_MODEL=codestral-latest
# Encrypts per-project API keys at rest; without it they don't survive a restart.
LLM_ENCRYPTION_KEY=change-me
AI_ASSISTANT_RATE_LIMIT_REQUESTS=10
AI_ASSISTANT_RATE_LIMIT_WINDOW=60
