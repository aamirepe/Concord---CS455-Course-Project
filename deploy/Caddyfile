# Caddy reverse proxy with automatic Let's Encrypt.
#
# Routes:
#   /api/*    -> backend, with the /api prefix stripped (the frontend is built
#                with VITE_API_URL=https://<domain>/api; FastAPI routes have no prefix)
#   /ws/*     -> backend (WebSockets)
#   /docs, /openapi.json, /redoc, /healthz -> backend
#   everything else -> the frontend container (static Vite build)
#
# CONCORD_DOMAIN comes from the host's .env via docker-compose.prod.yml. Set it
# to e.g. "http://localhost" to serve plain HTTP without a certificate.

{$CONCORD_DOMAIN:localhost} {
    encode zstd gzip
    header X-Content-Type-Options nosniff

    handle_path /api/* {
        reverse_proxy backend:8000
    }

    @backend path /ws/* /docs /openapi.json /redoc /healthz
    handle @backend {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}
